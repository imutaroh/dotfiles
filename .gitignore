# 機密情報
.env
.env.*
*.pem
*.key
id_rsa*
*.secret

# 認証情報
credentials.json
token.json
*_credentials.json

# ローカル設定（個人環境固有）
.local/
.cache/
.claude/settings.local.json
.claude/tmp/
.claude/worktrees/

# 私的データ（タスク実体は公開しない）
.claude/task-dashboard/

# OS生成ファイル
.DS_Store
Thumbs.db

# エディタ
*.swp
*.swo
*~

# Python
__pycache__/
*.pyc

# 外部インストーラ（npx skills add）生成物。実体は ~/.agents/skills/ にあり、ここにあるのは symlink。
# 再導入は /find-skills 経由で行う
.claude/skills/grill-me
.claude/skills/grilling

# claude.ai が同期するスキル（Anthropic 提供・アカウント側で管理され自動で書き換わる）
.claude/skills/synced/
# terminal-browser のインストーラが張る symlink（実体は ~/.local/share/terminal-browser/）
.claude/skills/terminal-browser
