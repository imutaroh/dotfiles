# 機密情報
.env
.env.*
*.pem
*.key
id_rsa*
*.secret

# 認証情報
credentials.json
token.json
*_credentials.json

# ローカル設定（個人環境固有）
.local/
.cache/
.claude/settings.local.json
.claude/tmp/
.claude/worktrees/

# 私的データ（公開しない）
.claude/CLAUDE.md
