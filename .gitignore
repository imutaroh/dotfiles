# 機密情報
.env
.env.*
*.pem
*.key
id_rsa*
*.secret

# 認証情報
credentials.json
token.json
*_credentials.json

# ローカル設定（個人環境固有）
.local/
.cache/
.claude/settings.local.json
.claude/tmp/
.claude/worktrees/

# 私的データ（公開しない）
.claude/CLAUDE.md
.claude/task-dashboard/
.claude/skills/gh-teach/
.claude/skills/agile-data-modeling
iphone/keep.txt
launchd/com.imutaro.ai-usage-dashboard.plist

# Herdr が mod のフォルダに生成する型定義（herdr-app check など）
.config/herdr-app/mods/*/gpui-kit.d.ts
.config/herdr-app/mods/*/jsconfig.json

# OS生成ファイル
.DS_Store
Thumbs.db

# エディタ
*.swp
*.swo
*~

# Python
__pycache__/
*.pyc

# 外部インストーラ（npx skills add）生成物。実体は ~/.agents/skills/ にあり、ここにあるのは symlink。
# 再導入は /find-skills 経由で行う
.claude/skills/grill-me
.claude/skills/grilling

# ctx が導入するスキル（ctx integrations で入れ直す）。配布条件を確認できないので追跡しない
.claude/skills/ctx-agent-history-search/

# claude.ai が同期するスキル（Anthropic 提供・アカウント側で管理され自動で書き換わる）
.claude/skills/synced/
# terminal-browser のインストーラが張る symlink（実体は ~/.local/share/terminal-browser/）
.claude/skills/terminal-browser
