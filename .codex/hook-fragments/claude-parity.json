{
  "description": "Claude Codeと共通の確認音・完了音。既存hooks.jsonへイベント単位で追加し、Codexの/hooksで確認する。",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/dotfiles/.claude/hooks/play-sound.sh ~/dotfiles/.claude/sounds/confirm.wav",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/dotfiles/.claude/hooks/play-sound.sh ~/dotfiles/.claude/sounds/complete.wav",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
