# 名前とメールは追跡しない。~/.gitconfig.local の [user] に書く
[include]
	path = ~/.gitconfig.local

# 未設定のままコミットしたときに、ホスト名などから身元を推測させない
[user]
	useConfigOnly = true

[core]
	editor = nvim
	autocrlf = input
	excludesfile = ~/.config/git/ignore

[init]
	defaultBranch = main

[pull]
	rebase = false

[push]
	default = current

[merge]
	conflictstyle = diff3

[diff]
	algorithm = histogram

[help]
	autocorrect = 0

# リポジトリ内にコミットされた bare リポジトリ形のディレクトリを暗黙に認識させない。
# その config の core.fsmonitor 等がプロンプトやエディタの git 呼び出しで実行されるのを防ぐ
[safe]
	bareRepository = explicit
