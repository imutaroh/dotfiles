[user]
	name = imutaakihiro
	email = imutaakihiro3@gmail.com

[core]
	editor = nvim
	autocrlf = input
	excludesfile = ~/.config/git/ignore

[init]
	defaultBranch = main

[pull]
	rebase = false

[push]
	default = current

[merge]
	conflictstyle = diff3

[diff]
	algorithm = histogram

[help]
	autocorrect = 0

# リポジトリ内にコミットされた bare リポジトリ形のディレクトリを暗黙に認識させない。
# その config の core.fsmonitor 等がプロンプトやエディタの git 呼び出しで実行されるのを防ぐ
[safe]
	bareRepository = explicit
