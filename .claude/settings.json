{
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_CODE_FORCE_TERMINAL_IMAGES": "1",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/dotfiles/.claude/mods/image-view-bytes"
  },
  "permissions": {
    "allow": [
      "Bash(brew --prefix:*)",
      "Bash(brew --version:*)",
      "Bash(brew config:*)",
      "Bash(brew deps:*)",
      "Bash(brew doctor:*)",
      "Bash(brew info:*)",
      "Bash(brew leaves:*)",
      "Bash(brew list:*)",
      "Bash(brew outdated:*)",
      "Bash(brew search:*)",
      "Bash(brew services list:*)",
      "Bash(cd:*)",
      "Bash(date:*)",
      "Bash(echo:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh repo list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh search:*)",
      "Bash(gh status:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow view:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git stash:*)",
      "Bash(git status:*)",
      "Bash(git switch:*)",
      "Bash(ls:*)",
      "Bash(pwd:*)",
      "Bash(trash:*)",
      "Bash(tree:*)",
      "Bash(TZ=Asia/Tokyo date:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Read",
      "WebSearch",
      "Bash(git merge *)",
      "Bash(go version *)",
      "Bash(mise ls:*)",
      "Bash(mise current:*)",
      "Bash(mise which:*)",
      "Bash(mise doctor:*)",
      "Bash(mise --version)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push *--delete*)",
      "Bash(git push *--receive-pack*)",
      "Bash(git push *--exec*)",
      "Bash(git fetch *--upload-pack*)",
      "Bash(git pull *--upload-pack*)",
      "Bash(git log *--output*)",
      "Bash(git diff *--output*)",
      "Bash(git reset --hard*)",
      "Bash(git reset *--hard*)",
      "Bash(git clean *)",
      "Bash(git fetch *--up*)",
      "Bash(git pull *--up*)",
      "Bash(git log *--ou*)",
      "Bash(git diff *--ou*)",
      "Bash(git push -uf*)",
      "Bash(git push * -uf*)",
      "Bash(git push -d*)",
      "Bash(git push * -d*)",
      "Bash(git push * :*)",
      "Bash(tree -o*)",
      "Bash(tree * -o*)",
      "Skill(anthropic-skills:obsidian-daily)"
    ],
    "ask": [
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh pr ready*)",
      "Bash(gh api *)",
      "mcp__claude_ai_Slack__slack_send_message",
      "mcp__claude_ai_Slack__slack_schedule_message",
      "mcp__claude_ai_Gmail__send_message",
      "mcp__claude_ai_Gmail__reply",
      "mcp__claude_ai_Gmail__forward"
    ]
  },
  "fallbackModel": [
    "claude-opus-5",
    "claude-sonnet-5-5"
  ],
  "deniedMcpServers": [
    {
      "serverName": "claude.ai Google Drive"
    },
    {
      "serverName": "claude.ai freee"
    }
  ],
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/play-sound.sh ~/.claude/sounds/confirm.wav"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/play-sound.sh ~/.claude/sounds/complete.wav"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit|overloaded|server_error|max_output_tokens|billing_error|authentication_failed",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/play-sound.sh ~/.claude/sounds/confirm.wav"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/scripts/hc-label-claude-session.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "claude-security@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "outputStyle": "default",
  "language": "japanese",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {},
    "claude-sonnet-5-5": {
      "effortLevel": "low"
    }
  },
  "advisorModel": "fable",
  "awaySummaryEnabled": false,
  "showClearContextOnPlanAccept": true,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "showThinkingSummaries": true,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:dark-daltonized-cool",
  "agentPushNotifEnabled": true
}
