{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_CODE_FORCE_TERMINAL_IMAGES": "1"
  },
  "permissions": {
    "allow": [
      "Bash(brew --prefix:*)",
      "Bash(brew --version:*)",
      "Bash(brew config:*)",
      "Bash(brew deps:*)",
      "Bash(brew doctor:*)",
      "Bash(brew info:*)",
      "Bash(brew leaves:*)",
      "Bash(brew list:*)",
      "Bash(brew outdated:*)",
      "Bash(brew search:*)",
      "Bash(brew services list:*)",
      "Bash(cd:*)",
      "Bash(date:*)",
      "Bash(echo:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh repo list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh search:*)",
      "Bash(gh status:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow view:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git stash:*)",
      "Bash(git status:*)",
      "Bash(git switch:*)",
      "Bash(ls:*)",
      "Bash(pwd:*)",
      "Bash(trash:*)",
      "Bash(tree:*)",
      "Bash(TZ=Asia/Tokyo date:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Read",
      "WebFetch",
      "WebSearch",
      "Bash(git reset *)",
      "Bash(git merge *)",
      "Bash(go version *)",
      "Bash(go mod *)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(mise ls:*)",
      "Bash(mise current:*)",
      "Bash(mise which:*)",
      "Bash(mise doctor:*)",
      "Bash(mise --version)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push *--delete*)",
      "Bash(git push *--receive-pack*)",
      "Bash(git push *--exec*)",
      "Bash(git fetch *--upload-pack*)",
      "Bash(git pull *--upload-pack*)",
      "Bash(git log *--output*)",
      "Bash(git diff *--output*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "enabledMcpjsonServers": [
    "obsidian"
  ],
  "deniedMcpServers": [
    {
      "serverName": "claude.ai Google Drive"
    },
    {
      "serverName": "claude.ai freee"
    }
  ],
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/play-sound.sh ~/.claude/sounds/confirm.wav"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/play-sound.sh ~/.claude/sounds/complete.wav"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/imutaakihiro/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "claude-security@claude-plugins-official": true,
    "terminal-browser@terminal-browser": true,
    "gopls-lsp@claude-plugins-official": true,
    "image-view@claude-image-view": true,
    "effort-auto@hide10": true,
    "cloudflare@cloudflare": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "terminal-browser": {
      "source": {
        "source": "github",
        "repo": "zenbu-labs/terminal-browser"
      }
    },
    "claude-image-view": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-image-view"
      }
    },
    "hide10": {
      "source": {
        "source": "github",
        "repo": "k-hide10/claude-code-plugins"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    }
  },
  "outputStyle": "Explanatory",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "fable",
  "awaySummaryEnabled": false,
  "showClearContextOnPlanAccept": true,
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "custom:dark-daltonized-cool",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: Private — imutaroh/ObsidianImus (GitHub)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: Default branch main; no protected branches or rulesets listed (rulesets not queryable here)",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Source control**: The trusted repo (imutaroh/ObsidianImus) and its origin remote on github.com only — no additional orgs configured",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: Private/Finance/ (gitignored — financial data); Private/AI workspace/ draft notes pending manual review before promotion to Notes/; any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (hyphen/underscore/dot-delimited — e.g. matches `prod-db`, not `producer`)",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: personal knowledge-management (Obsidian vault: notes, learning, journaling) — hobby/personal use",
      "**Trusted repo**: imutaroh/ObsidianImus (private, github.com/imutaroh/ObsidianImus) — the working directory and its origin remote; confidential personal notes are fine to commit here given private visibility, but Private/Finance/ and other credential/regulated material are excluded regardless of visibility",
      "**Org-specific CLIs**: None configured — routine personal CLIs observed: ctx, codex, trash, brew, nvim, herdr, gdev, hunk (no org affiliation evidenced)",
      "**routine under ~/repos/imutaroh/ObsidianImus/ prefix**: Notes/, Private/AI workspace/, and .claude/ file operations are routine for this vault"
    ]
  },
  "voiceEnabled": true
}
